{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "/", "permanent": false },
    { "source": "/admin/:path*", "destination": "/", "permanent": false },
    { "source": "/docs/admin", "destination": "/", "permanent": false },
    { "source": "/docs/admin/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/blue", "destination": "/docs/admin/index.html" },
    { "source": "/blue/(.*)", "destination": "/docs/admin/$1" },
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/(.*)", "destination": "/docs/$1" }
  ]
}
